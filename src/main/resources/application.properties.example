# ========================================================
# BloodConnect Application Configuration Template
# ========================================================

app.name=BloodConnect
app.version=1.0.0
app.context=/BloodConnect
app.port=8080

# Database Configuration (MySQL / MariaDB)
# For Render / Docker / Cloud production, supply via Environment Variables:
#   DATABASE_URL=mysql://user:pass@host:3306/bloodconnect_db
#   OR
#   DB_HOST=...
#   DB_PORT=3306
#   DB_NAME=bloodconnect_db
#   DB_USER=...
#   DB_PASSWORD=...
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/bloodconnect_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=

# Connection Pool Settings
db.pool.initialSize=5
db.pool.maxTotal=20
db.pool.maxIdle=10
db.pool.minIdle=2
db.pool.maxWaitMillis=10000

# Zero-Config Fallback (Set to false on production via DB_FALLBACK_H2=false)
db.fallback.h2=true
